# Stable by-id path for the attached Logitech UVC camera on this machine.
CAMERA=/dev/v4l/by-id/usb-046d_0825_CAA383D0-video-index0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=960
CAMERA_FPS=5

# Detection behavior
COOLDOWN_MINUTES=10
SCAN_INTERVAL_SECONDS=1
DETECTION_CONFIDENCE=0.35
BIRD_IMAGE_DIR=bird_images
BURST_FRAMES=7
SHARPEST_FRAMES=3
CONSENSUS_MIN_VOTES=2
SPECIES_MIN_CONFIDENCE=0.70
SPECIES_MIN_MARGIN=0.20
REGION_PROFILE=northern_nj
REGIONAL_PRIOR_WEIGHT=3.0

# Pretrained local models. Downloaded automatically on first run and then cached.
DETECTOR_MODEL=yolo11n.pt
DETECTOR_MODEL_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1
CLASSIFIER_MODEL=chriamue/bird-species-classifier
CLASSIFIER_REVISION=558944ca4448f5b311af8393c8b894eff20a06da
# BioCLIP is blended with the broad classifier for stronger local feeder-bird evidence.
LOCAL_CLASSIFIER_MODEL=imageomics/bioclip
LOCAL_CLASSIFIER_REVISION=ce901ab3c6a913f9e9ef94ce6d27761069f4f01c
LOCAL_CLASSIFIER_WEIGHT=0.65

# SMTP example for Gmail. Use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
# One address or a comma-separated recipient list.
EMAIL_TO=recipient@example.com
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
# Leave false. Set true only for a trusted local relay that intentionally has no TLS.
SMTP_ALLOW_INSECURE=false
