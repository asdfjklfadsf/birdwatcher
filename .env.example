# Camera configuration. Start with index 0 for a normal USB webcam.
# On Linux, prefer a stable /dev/v4l/by-id/... path when available.
CAMERA=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=960
CAMERA_FPS=5

# Detection and active-event behavior
SCAN_INTERVAL_SECONDS=1
DETECTION_CONFIDENCE=0.35
DETECTION_CROP_PADDING=0.20
BIRD_IMAGE_DIR=bird_images
BURST_FRAMES=9
BURST_FRAME_INTERVAL_SECONDS=1.0
SHARPEST_FRAMES=7
MIN_VALID_BIRD_FRAMES=4
MIN_EVENT_DETECTOR_CONFIDENCE=0.07
DETECTION_FLOOR_CONFIDENCE=0.05
MAX_BIRD_CROP_ASPECT_RATIO=2.5

# Once a real bird event is confirmed, repeated detections of that same spatial
# event are suppressed before expensive classification. A bird is considered
# gone after EVENT_CLEAR_SECONDS with no matching detection. The maximum event
# age prevents one continuously present bird from being suppressed forever.
EVENT_CLEAR_SECONDS=3
ACTIVE_EVENT_MAX_MINUTES=10
# Backward compatibility: COOLDOWN_MINUTES is used as the maximum event age only
# when ACTIVE_EVENT_MAX_MINUTES is not set.
# COOLDOWN_MINUTES=10

# Separate BioCLIP bird-vs-empty-feeder gate. Requires repeated visible-bird evidence.
MIN_BIRD_PRESENCE_SCORE=0.50
MIN_BIRD_PRESENCE_FRAMES=2
CONSENSUS_MIN_VOTES=4
SPECIES_MIN_CONFIDENCE=0.60
SPECIES_MIN_MARGIN=0.20
REGION_PROFILE=northern_nj
REGIONAL_PRIOR_WEIGHT=3.0

# Pretrained local models. Downloaded automatically on first run and then cached.
DETECTOR_MODEL=yolo11n.pt
DETECTOR_MODEL_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1
CLASSIFIER_MODEL=chriamue/bird-species-classifier
CLASSIFIER_REVISION=558944ca4448f5b311af8393c8b894eff20a06da
# BioCLIP is blended with the broad classifier for stronger visual evidence.
LOCAL_CLASSIFIER_MODEL=imageomics/bioclip
LOCAL_CLASSIFIER_REVISION=ce901ab3c6a913f9e9ef94ce6d27761069f4f01c
LOCAL_CLASSIFIER_WEIGHT=0.65

# SMTP example for Gmail. Use an app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
# One address or a comma-separated recipient list.
EMAIL_TO=recipient@example.com
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
# Leave false. Set true only for a trusted local relay that intentionally has no TLS.
SMTP_ALLOW_INSECURE=false
